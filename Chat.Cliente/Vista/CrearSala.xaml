<UserControl x:Class="Chat.Vista.CrearSala"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
   
        <Grid >
          
            <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin ="0 0 0 5" >
               <Label  Content="CREAR SALA" FontSize="20" HorizontalAlignment="Center" />  
               <TextBlock Text=" "/>
               <Label  Content="NOMBRE DE LA SALA" FontSize="20" HorizontalAlignment="Left" /> 
               <TextBox  Text="{Binding Sala.Nombre}" FontSize="20" HorizontalAlignment="Left" Width="200" Height="30" />
               <TextBlock Text=" "/>

                <StackPanel Orientation="Horizontal" >
                    <Label  Content="CAPACIDAD" FontSize="20" Margin="0 0 200 0" />
                    <Label  Content="CONTRASEÑA" FontSize="20"  />
                </StackPanel>

                <StackPanel Orientation="Horizontal" >
                    <TextBox  Text="{Binding Sala.Capacidad }" FontSize="20" HorizontalAlignment="Left" Width="200" Height="30" Margin="0 0 100 0" />
                    
                    <TextBox  Text="{Binding Sala.Contraseña }" FontSize="20" HorizontalAlignment="Right" Width="200" Height="30" />
                </StackPanel>
        
                <TextBlock Text=" "/>

                <Label Content="VISIBILIDAD"/>
                <ComboBox FontSize="20" SelectedItem="{Binding Sala.Visibilidad}" >
                    <ComboBoxItem Content="Publico" IsSelected="True"/>
                    <ComboBoxItem Content="Privado"/>
                </ComboBox>

                <TextBlock Text=" "/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    <Button FontSize="20" Content="GUARDAR" HorizontalAlignment="Left" Background="Blue" Foreground="White" Margin="0 0 50 0" Command="{Binding AbrirSalaDeChat}"   />
                    <Button FontSize="20" Content="CANCELAR" HorizontalAlignment="Right" Background="White" Foreground="Black" Command="{Binding AbrirListaDeSalas}"/>
                </StackPanel>
                
               
            </StackPanel>
               
        </Grid>

</UserControl>