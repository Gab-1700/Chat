<UserControl x:Class="Chat.Vista.CrearSala"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             Background="#F5F7FA">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorTexto"
                Color="#1F2937"/>
        <SolidColorBrush x:Key="ColorSecundario"
                Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorBorde"
                Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ColorPrimario"
                Color="#4F46E5"/>

        <Style TargetType="Label">
            <Setter Property="Foreground"
                    Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="12,10"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="16,12"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="8"/>
            <Setter Property="MinHeight"
                    Value="40"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource ColorBorde}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Border Background="White"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28"
                Width="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                    <TextBlock Text="Crear sala"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <TextBlock Text="Configura tu nueva sala de chat."
                               FontSize="13"
                               Foreground="{StaticResource ColorSecundario}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Nombre -->
                <StackPanel Grid.Row="1"
                        Margin="0,0,0,18">
                    <Label Content="Nombre de la sala"/>

                    <TextBox Text="{Binding Sala.Nombre,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"/>
                </StackPanel>

                <!-- Capacidad -->
                <StackPanel Grid.Row="2"
                        Margin="0,0,0,18">
                    <Label Content="Capacidad máxima"/>

                    <TextBox Text="{Binding Sala.Capacidad,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="4"/>
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Grid.Row="3"
                        Margin="0,0,0,18">
                    <Label Content="Contraseña (opcional)"/>

                    <TextBox Text="{Binding Sala.Contraseña,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Acciones -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Guardar"
                            Background="{StaticResource ColorPrimario}"
                            Foreground="White"
                            Command="{Binding AbrirSalaDeChat}"/>

                    <Button Grid.Column="2"
                            Content="Cancelar"
                            Background="#F3F4F6"
                            Foreground="{StaticResource ColorTexto}"
                            Command="{Binding AbrirListaDeSalas}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
