
<UserControl x:Class="Chat.Vista.ListaDeSalas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             Background="#F5F7FA">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorTexto" Color="#1F2937"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ColorPrimario" Color="#4F46E5"/>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado y perfil -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lista de salas"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <TextBlock Text="Encuentra una sala y únete a la conversación."
                               FontSize="13"
                               Foreground="{StaticResource ColorSecundario}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock Text="{Binding Usuario.Nombre}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"
                                   HorizontalAlignment="Right"/>

                        <Button Content="Editar perfil"
                                Background="#EEF2FF"
                                Foreground="#4338CA"
                                Padding="8,5"
                                Margin="0,4,0,0"
                                Command="{Binding AbrirRegistroDeUsuario}"/>
                    </StackPanel>

                    <Image Source="Imagenes/5834524.png"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"
                           VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Listado de salas -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Salas disponibles"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}"
                           Margin="0,0,0,12"/>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Salas}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB"
                                    BorderBrush="{StaticResource ColorBorde}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ColorTexto}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,6,0,0">

                                            <TextBlock Text="Capacidad: "
                                                       FontSize="12"
                                                       Foreground="{StaticResource ColorSecundario}"/>

                                            <TextBlock Text="{Binding Capacidad}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource ColorSecundario}"/>

                                            <TextBlock Text="  ·  "
                                                       Foreground="{StaticResource ColorSecundario}"/>

                                            <TextBlock Text="{Binding Visibility}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource ColorSecundario}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Unirse"
                                            Background="{StaticResource ColorPrimario}"
                                            Foreground="White"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            Command="{Binding DataContext.AbrirSalaDeChat,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Acción principal -->
        <Button Grid.Row="2"
                Content="+ Crear sala"
                HorizontalAlignment="Stretch"
                Background="{StaticResource ColorPrimario}"
                Foreground="White"
                Padding="16,14"
                FontSize="14"
                Command="{Binding AbrirCrearSalaDeChat}"/>

    </Grid>
</UserControl>
