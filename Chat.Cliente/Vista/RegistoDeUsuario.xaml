<UserControl x:Class="Chat.Vista.RegistroDeUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:conversores="clr-namespace:Chat.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
         <conversores:ConversorDeColor x:Key="Conversor" />
    </UserControl.Resources>
    <Grid Margin="50 30 50 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Label  Content="DEFINIR USUARIO" Grid.ColumnSpan="2" FontSize="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Label Grid.Row ="1" Grid.Column="0" Content="NOMBRE" FontSize="25" HorizontalContentAlignment="Left"  />       
        <TextBox Grid.Row ="1" Grid.Column="1"  FontSize="30" Margin="0 0 0 10" Text="{Binding Usuario.Nombre}" />   
        <Label Grid.Row ="2" Grid.Column="0" Content="AVATAR" FontSize="25" HorizontalContentAlignment="Left"  />  
        <TextBox Grid.Row ="2" Grid.Column="1"  FontSize="25" Margin="0 0 0 10" />  
        <Label Grid.Row ="3" Grid.Column="0" Content="COLOR" FontSize="25" HorizontalContentAlignment="Left"  />  
        <xctk:ColorPicker Grid.Row="3" Grid.Column="1" Margin="0 0 0 10" SelectedColor="{Binding Usuario.Color, Converter={StaticResource Conversor}}"  />

       
        <Button Grid.Row="4" Content="GUARDAR" Grid.Column="0" Command="{Binding AbrirListaDeSala}"  Grid.ColumnSpan="2" /> 
        

    </Grid>

</UserControl>