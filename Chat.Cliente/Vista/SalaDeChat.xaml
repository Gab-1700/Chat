<UserControl x:Class="Chat.Vista.SalaDeChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conversores="clr-namespace:Chat.Cliente.Conversores"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="#F5F7FA">

    <UserControl.Resources>
        <conversores:ConversorBrush x:Key="CBrush"/>

        <SolidColorBrush x:Key="FondoPanel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#1F2937"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ColorPrimario" Color="#4F46E5"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="{StaticResource FondoPanel}"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Sala.Nombre}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorTexto}"/>

                    <TextBlock Text="{Binding Usuario.Nombre, StringFormat='Conectado como {0}'}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorSecundario}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                     <!-- Visible solo para el anfitrión -->
                    <Button Content="Editar sala"
                            Background="#EEF2FF"
                            Foreground="#4338CA"
                            Command="{Binding AbrirCrearSala}"
                            Visibility="{Binding Anfitrion}"/>

                    <!-- TODO: Visible solo para el anfitrión -->
                    <!--<Button Content="Cerrar sala"
                            Background="#FEE2E2"
                            Foreground="#B91C1C"
                            Command="{Binding AbrirListaDeSalas}"
                            Visibility="{Binding Anfitrion}"/>-->

                    <!-- Visible para los demás visitantes -->
                    <Button Content="Salir"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            Command="{Binding AbrirListaDeSalas}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Mensajes -->
            <Border Grid.Column="0"
                    Background="{StaticResource FondoPanel}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,8,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Mensajes"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTexto}"
                               Margin="0,0,0,12"/>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Mensajes}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        Margin="0,2"
                                        Background="#F9FAFB"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Usuario.Nombre}"
                                                       Foreground="{Binding Usuario.Color,
                                                           Converter={StaticResource CBrush}}"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Left"/>

                                            <TextBlock Text="{Binding Fecha}"
                                                       Foreground="{StaticResource ColorSecundario}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Texto}"
                                                   Foreground="{StaticResource ColorTexto}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Usuarios -->
            <Border Grid.Column="1"
                    Background="{StaticResource FondoPanel}"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="8,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Usuarios.Count,
                                      StringFormat='Participantes ({0})'}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTexto}"
                               Margin="0,0,0,12"/>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Usuarios}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Nombre}"
                                               Foreground="{Binding Color,
                                                   Converter={StaticResource CBrush}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    
                                    <!-- TODO    modificar visibilit para el host
                                    <TextBlock Text="HOST"
                                               Visibility="{Binding Anfitrion}"
                                               Foreground="#4338CA"
                                               Background="#EEF2FF"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>-->
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Entrada del mensaje -->
        <Border Grid.Row="2"
                Background="{StaticResource FondoPanel}"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding MensajeTxt,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="False"/>

                <Button Grid.Column="1"
                        Content="Enviar"
                        Background="{StaticResource ColorPrimario}"
                        Foreground="White"
                        Command="{Binding EnviarMensaje}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
