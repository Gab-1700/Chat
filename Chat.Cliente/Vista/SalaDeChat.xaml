<UserControl x:Class="Chat.Vista.SalaDeChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conversores="clr-namespace:Chat.Cliente.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
        <UserControl.Resources>
            <conversores:ConversorBrush x:Key="CBrush" />
            <conversores:ConversorVisibility x:Key="CVisibility" />
        </UserControl.Resources>
   
        <Grid >
          
            <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin ="0 0 0 5" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Label  Content="{Binding Usuario.Nombre}" FontSize="20"  />
                    <Label  Content="AVATAR" FontSize="20"  />
                </StackPanel>
                <TextBlock Text=" "/>

                 <StackPanel Orientation="Horizontal"  >
                    <Label  Content="{Binding Sala.Nombre}" FontSize="20" Margin="0 0 400 0"  />
                    <Button  Content="EDITAR" FontSize="20"  Margin="0 0 20 0" Background="White" Foreground="Black" Command="{Binding AbrirCrearSala}"/>
                    <Button  Content="CERRAR" FontSize="20"  HorizontalAlignment="Right"  Background="RED" Foreground="White" Command="{Binding AbrirListaDeSalas}"/>
                </StackPanel>
                
                <TextBlock Text=" "/>

             
             <StackPanel Orientation="Horizontal "> 
                <ListView Width="500" Height="200" Margin="0 0 20 0" ItemsSource="{Binding Mensajes}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Usuario.Nombre}" Foreground="{Binding Usuario.Color, Converter={StaticResource CBrush}}"  FontWeight="Bold" Margin="5" />
                                    <TextBlock Text="{Binding Texto}" Margin="5" />
                                    <TextBlock Text="{Binding Fecha}" Margin="5" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>

                <ListView  Width="200" Height="200" ItemsSource="{Binding Usuarios}" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Imagen}" Margin="5" />
                                    <TextBlock Text="{Binding Nombre}" Foreground="{Binding Color, Converter={StaticResource CBrush}}" Margin="5"  FontWeight="Bold"/>
                                    <TextBlock Text="(ADMIN)" Visibility="{Binding EsAnfitrion, Converter={StaticResource CVisibility}}" Margin ="5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>
             </StackPanel> 

            <TextBlock Text=" "/>
             <StackPanel Orientation="Horizontal">
                <Border BorderBrush="black" BorderThickness="1" Height="50" Width="400" Margin ="0 0 20 5" HorizontalAlignment="Right" >
                    
                        <TextBox Height="50" FontSize="20" Text ="{Binding MensajeTxt,Mode=TwoWay}" />
                        
                    
                </Border>
                <Button Content="ENVIAR" FontSize="20" Background="Orange" Foreground="White" Command="{Binding EnviarMensaje}"/>
                        
             </StackPanel>

              

        
            </StackPanel>
               
        </Grid>

</UserControl>