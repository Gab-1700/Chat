<UserControl x:Class="Chat.Vista.SalaDeChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
   
        <Grid >
          
            <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin ="0 0 0 5" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Label  Content="{Binding Usuario.Nombre}" FontSize="20"  />
                    <Label  Content="AVATAR" FontSize="20"  />
                </StackPanel>
                <TextBlock Text=" "/>

                 <StackPanel Orientation="Horizontal"  >
                    <Label  Content="{Binding Sala.Nombre}" FontSize="20" Margin="0 0 400 0"  />
                    <Button  Content="EDITAR" FontSize="20"  Margin="0 0 20 0" Background="White" Foreground="Black" Click="EditarSala"/>
                    <Button  Content="CERRAR" FontSize="20"  HorizontalAlignment="Right"  Background="RED" Foreground="White" Click="CerrarSala"/>
                </StackPanel>
                
                <TextBlock Text=" "/>

             
             <StackPanel Orientation="Horizontal "> 
                <ListView Width="500" Height="200" Margin="0 0 20 0" ItemsSource="{Binding Mensajes, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Propietario}" Margin="5" />
                                    <TextBlock Text="{Binding Texto}" Margin="5" />
                                    <TextBlock Text="{Binding Fecha}" Margin="5" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>

                <ListView  Width="200" Height="200" ItemsSource="{Binding Usuarios, Mode=TwoWay}" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Nombre}" Margin="5" />
                                    <TextBlock Text="{Binding Imagen}" Margin="5" />
                                    <TextBlock Text="{Binding Color}" Margin="5" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>
             </StackPanel> 

            <TextBlock Text=" "/>
             <StackPanel Orientation="Horizontal">
                <Border BorderBrush="black" BorderThickness="1" Height="50" Width="400" Margin ="0 0 20 5" HorizontalAlignment="Right" >
                    
                        <TextBox x:Name="TxtMensaje" Height="50" FontSize="20" />
                        
                    
                </Border>
                <Button Content="ENVIAR" FontSize="20" Background="Orange" Foreground="White" Click="EnviarMensaje"/>
                        
             </StackPanel>

              

        
            </StackPanel>
               
        </Grid>

</UserControl>